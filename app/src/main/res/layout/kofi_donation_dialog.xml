<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☕ "
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Support Ayushflix"
            android:textColor="?attr/textColor"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Developer Story / Notice -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hey there! 👋 Creating and maintaining our custom streaming engine, reverse-engineering the APIs, deploying our Singapore node, and keeping servers running 24/7 ad-free has taken immense effort and countless sleepless nights.\n\nIf you enjoy streaming on Ayushflix, please consider buying a coffee on Ko-fi to help keep the servers alive and free for everyone!"
        android:textColor="?attr/textColor"
        android:alpha="0.85"
        android:lineSpacingExtra="4dp"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- Ko-fi Support Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/kofi_support_btn"
        style="@style/WhiteButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="☕ Support on Ko-fi (@jaatayushh)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Maybe Later Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/kofi_remind_later_btn"
        style="@style/BlackButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Maybe Later"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <!-- Don't Remind Me Again Button -->
    <TextView
        android:id="@+id/kofi_dismiss_forever_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="Don't remind me again"
        android:textColor="?attr/textColor"
        android:alpha="0.6"
        android:textSize="12sp" />

</LinearLayout>
