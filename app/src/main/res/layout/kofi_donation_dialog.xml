<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 "
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to Ayushflix"
            android:textColor="?attr/textColor"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Developer Story / Notice -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hey there! 👋 Creating and maintaining the universal streaming engine, reverse-engineering the APIs, deploying our Singapore node, and keeping servers running 24/7 ad-free has taken immense effort and sleepless nights.\n\nEnjoy streaming, connect your Google account to sync your Continue Watching across devices, or support on Ko-fi to help pay server bills!"
        android:textColor="?attr/textColor"
        android:alpha="0.85"
        android:lineSpacingExtra="3dp"
        android:textSize="13sp"
        android:layout_marginBottom="18dp" />

    <!-- Google Login Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/kofi_google_login_btn"
        style="@style/WhiteButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🔑 Sign in with Google (Cloud Sync)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Ko-fi Support Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/kofi_support_btn"
        style="@style/BlackButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="☕ Support on Ko-fi (@jaatayushh)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Continue as Guest / Don't show again Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/kofi_dismiss_forever_btn"
        style="@style/BlackButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Continue as Guest (Don't Show Again)"
        android:textSize="13sp"
        android:alpha="0.75"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:text="You can always access Google Login &amp; Ko-fi in Settings"
        android:textColor="?attr/textColor"
        android:alpha="0.5"
        android:textSize="11sp" />

</LinearLayout>
