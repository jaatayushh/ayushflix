<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_match_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#1C1C1E"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Larger Poster image with rounded corners -->
        <androidx.cardview.widget.CardView
            android:layout_width="120dp"
            android:layout_height="170dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#111111">

            <ImageView
                android:id="@+id/top_match_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </androidx.cardview.widget.CardView>

        <!-- Details on the right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <!-- "TOP MATCH" red badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP MATCH"
                android:textColor="#E50914"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <!-- Larger Title -->
            <TextView
                android:id="@+id/top_match_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <!-- Type -->
            <TextView
                android:id="@+id/top_match_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3B3B3"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Larger Play Button with high contrast -->
            <TextView
                android:id="@+id/top_match_play"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="▶  Play"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:background="@drawable/bg_netflix_button_white"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
