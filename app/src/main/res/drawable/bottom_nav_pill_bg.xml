<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass Pill Background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Frosted Obsidian Glass Body (Translucent charcoal glass) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D0141418" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <!-- Layer 2: Glossy Liquid Sheen along top half -->
    <item
        android:top="0dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="30dp"
                android:topRightRadius="30dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Layer 3: Crisp Liquid Glass Border Rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1.2dp"
                android:color="#4DFFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>

</layer-list>
